{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tosi/power/1",
  "title": "Power result",
  "description": "The worst-case e.i.r.p. towards Finland in each limit's reference bandwidth. See spec/stages/power/README.md.",
  "type": "object",
  "required": [
    "schema",
    "rulebook",
    "file",
    "counts",
    "notices",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "power/1"
    },
    "rulebook": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "cites"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cites": {
          "type": "object",
          "description": "The sources the stage's rulebook cites, copied from it: every entry named \"method\", \"basis\" or ending in \"_basis\", in rulebook order. Every result carries them, so a reader sees which guideline or policy set each number.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "description": "SHA-256 of the IFIC file this came from, as intake recorded it",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "notices",
        "rows",
        "rows_without_power"
      ],
      "additionalProperties": false,
      "properties": {
        "notices": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "rows_without_power": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notices": {
      "type": "array",
      "description": "In ascending ntc_id order",
      "items": {
        "type": "object",
        "required": [
          "ntc_id",
          "type",
          "rows",
          "eirp"
        ],
        "additionalProperties": false,
        "properties": {
          "ntc_id": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "eirp": {
            "type": [
              "number",
              "null"
            ],
            "description": "Highest e.i.r.p. over its rows, dBW in the reference bandwidth"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "description": "[grp_id, ntc_id, table, exam row, provision, e.i.r.p. dBW]",
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6
      }
    }
  }
}
