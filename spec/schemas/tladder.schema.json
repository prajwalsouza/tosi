{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tosi/tladder/1",
  "title": "Terrestrial ladder result",
  "description": "Every station on one rung. See spec/stages/tladder/README.md.",
  "type": "object",
  "required": [
    "schema",
    "rulebook",
    "file",
    "tables",
    "counts",
    "fields",
    "notices"
  ],
  "additionalProperties": false,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stamp": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "cites"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cites": {
          "type": "object",
          "description": "The sources the stage's rulebook cites, copied from it: every entry named \"method\", \"basis\" or ending in \"_basis\", in rulebook order. Every result carries them, so a reader sees which guideline or policy set each number.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "num": {
      "type": [
        "number",
        "null"
      ],
      "description": "Rounded to two decimals; null when it does not apply"
    },
    "counts": {
      "type": "object",
      "required": [
        "notices",
        "levels",
        "rungs"
      ],
      "properties": {
        "notices": {
          "$ref": "#/$defs/count"
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        },
        "rungs": {
          "type": "object",
          "description": "Filings per rung, in ladder order",
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "tladder/1"
    },
    "rulebook": {
      "$ref": "#/$defs/stamp"
    },
    "file": {
      "$ref": "#/$defs/sha256"
    },
    "tables": {
      "type": "object",
      "required": [
        "m4"
      ],
      "additionalProperties": false,
      "properties": {
        "m4": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of spec/tables/m4.json as read"
        }
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "fields": {
      "const": [
        "terrakey",
        "rung",
        "by",
        "excess",
        "stations_over",
        "m4"
      ]
    },
    "notices": {
      "type": "array",
      "description": "Every station in ladder order, as a row in the order of fields",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/num"
          },
          {
            "$ref": "#/$defs/count"
          },
          {
            "oneOf": [
              {
                "type": "null",
                "description": "Not checked: the case is not over or near the level"
              },
              {
                "type": "object",
                "required": [
                  "uses",
                  "exempt"
                ],
                "additionalProperties": false,
                "description": "Finnish use on the case's frequencies, from Finland's national frequency allocation table (Traficom Radio Frequency Regulation 4, M4; spec/tables/m4.json)",
                "properties": {
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every use whose sub-band touches the case's frequencies, once each, in table order"
                  },
                  "exempt": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Of those, the uses the table marks licence-exempt, in table order"
                  }
                }
              }
            ]
          }
        ],
        "items": false
      }
    }
  }
}
