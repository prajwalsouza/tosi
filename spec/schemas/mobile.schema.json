{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tosi/mobile/1",
  "title": "Land mobile result",
  "type": "object",
  "required": [
    "schema",
    "rulebook",
    "file",
    "counts",
    "notices",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "mobile/1"
    },
    "rulebook": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "cites"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cites": {
          "type": "object",
          "description": "The sources the stage's rulebook cites, copied from it: every entry named \"method\", \"basis\" or ending in \"_basis\", in rulebook order. Every result carries them, so a reader sees which guideline or policy set each number.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "notices",
        "kept",
        "left"
      ],
      "properties": {
        "notices": {
          "type": "integer",
          "minimum": 0
        },
        "kept": {
          "type": "integer",
          "minimum": 0
        },
        "left": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "description": "Every station, one compact row each, in the order of fields, ascending terrakey",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": [
              "string",
              "null"
            ]
          }
        ]
      }
    },
    "fields": {
      "const": [
        "terrakey",
        "adm",
        "cls",
        "f_mhz",
        "lon",
        "lat",
        "reason"
      ]
    }
  }
}
