{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tosi/field/1",
  "title": "Field strength result",
  "type": "object",
  "required": [
    "schema",
    "rulebook",
    "file",
    "counts",
    "notices",
    "tables"
  ],
  "properties": {
    "schema": {
      "const": "field/1"
    },
    "rulebook": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "cites"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cites": {
          "type": "object",
          "description": "The sources the stage's rulebook cites, copied from it: every entry named \"method\", \"basis\" or ending in \"_basis\", in rulebook order. Every result carries them, so a reader sees which guideline or policy set each number.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "notices"
      ],
      "properties": {
        "notices": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "terrakey",
          "e",
          "border",
          "km",
          "land"
        ],
        "properties": {
          "terrakey": {
            "type": "integer"
          },
          "e": {
            "type": "number",
            "description": "dB(µV/m) at the strongest border point"
          },
          "border": {
            "type": "integer"
          },
          "km": {
            "type": "number"
          },
          "land": {
            "type": "number",
            "description": "share of the path over land, 0 to 1"
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "required": [
        "p1546",
        "finland"
      ],
      "properties": {
        "p1546": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finland": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
