{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tosi/threshold/1",
  "title": "Threshold result",
  "type": "object",
  "required": [
    "schema",
    "rulebook",
    "file",
    "counts",
    "notices"
  ],
  "properties": {
    "schema": {
      "const": "threshold/1"
    },
    "rulebook": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "cites"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cites": {
          "type": "object",
          "description": "The sources the stage's rulebook cites, copied from it: every entry named \"method\", \"basis\" or ending in \"_basis\", in rulebook order. Every result carries them, so a reader sees which guideline or policy set each number.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "notices",
        "how"
      ],
      "properties": {
        "notices": {
          "type": "integer",
          "minimum": 0
        },
        "how": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "terrakey",
          "limit",
          "bc",
          "excess",
          "outcome",
          "coordinated"
        ],
        "properties": {
          "terrakey": {
            "type": "integer"
          },
          "limit": {
            "type": "number"
          },
          "bc": {
            "type": "number"
          },
          "excess": {
            "type": "number"
          },
          "outcome": {
            "enum": [
              "over",
              "over_coordinated",
              "near",
              "under"
            ]
          },
          "coordinated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
